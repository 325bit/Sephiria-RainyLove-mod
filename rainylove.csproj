<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RainyLove</AssemblyName>
    <RootNamespace>RainyLove</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Sephiria</GameDir>
    <ModRoot Condition="'$(ModRoot)' == ''">D:\workplace\Sephiria\mods\rainylove-bp6</ModRoot>
    <DeployMod Condition="'$(DeployMod)' == ''">false</DeployMod>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- ===== BepInEx 6 前置 =====
       本 mod 以 BepInEx 6（Unity Mono）为前置，编译时只引用 BepInEx 6 的程序集，
       不再引用 BepInEx 5 的 BepInEx.dll。参考程序集放在 libs/ 下（从 BepInEx 6
       Unity Mono 发行包的 BepInEx/core 中提取），运行时由游戏里已安装的 BepInEx 6 提供。
       注意：这些引用只用于编译，不会随 mod 一起输出（Private=false）。 -->
  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(MSBuildProjectDirectory)\libs\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(MSBuildProjectDirectory)\libs\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(MSBuildProjectDirectory)\libs\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 游戏自身程序集（与 BepInEx 版本无关，随游戏提供） -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- -p:DeployMod=true 时，编译完自动把 dll 部署到游戏的 BepInEx/plugins/RainyLove_AIZO -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\RainyLove_AIZO" />
    <Message Importance="high" Text="已部署：$(GameDir)\BepInEx\plugins\RainyLove_AIZO\$(AssemblyName).dll" />
  </Target>

</Project>
